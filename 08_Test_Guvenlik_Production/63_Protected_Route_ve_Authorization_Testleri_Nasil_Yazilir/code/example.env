# Bu dosyayı .env adıyla kopyalayın: cp example.env .env
# PowerShell: Copy-Item example.env .env
# Gerçek .env dosyasını GitHub'a göndermeyin.
# Sırlar için her değişkende ayrı çalıştırın: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# 2. kitap finalindeki transaction işlemleri MongoDB replica set / Atlas gerektirir.
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/movie_api_book_test
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info
SESSION_SECRET=CHANGE_ME_generate_independent_random_secret
JWT_ACCESS_SECRET=CHANGE_ME_generate_independent_random_secret
APP_BASE_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
SUPPORT_EMAIL_TO=support@example.com
AVATAR_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
