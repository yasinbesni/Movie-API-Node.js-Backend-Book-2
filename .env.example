# Movie API icin ornek ayarlar. Gercek bilgileri Git'e eklemeyin.
# Bu dosyayi calistirdiginiz movie-api/ klasorune .env adi ile kopyalayin.
# MongoDB baglanti bilgilerini kendi test veritabaniniza gore degistirin.
MONGODB_URL=mongodb+srv://book_user:PAROLAMIZ@bookcluster.xxxxx.mongodb.net/movieApp?retryWrites=true&w=majority&appName=BookCluster
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info

# 22. bolum / Session guvenligi asamasindan itibaren gereklidir.
# NODE_ENV=development
# SESSION_SECRET=replace-with-a-long-random-string

# 35. bolum / JWT asamasindan itibaren gereklidir.
# JWT_ACCESS_SECRET=replace-with-a-different-long-random-string
