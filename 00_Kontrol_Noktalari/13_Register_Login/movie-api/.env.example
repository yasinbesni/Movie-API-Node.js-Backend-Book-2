# Bu dosyayi .env adi ile kopyalayin ve ornek degerleri kendi bilgilerinizle degistirin.
# Gercek sifreleri ve gizli anahtarlari Git deposuna eklemeyin.

# MongoDB Atlas baglanti adresinizi yazin (USERNAME, PASSWORD ve YOUR_CLUSTER alanlarini degistirin).
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/movieApp?retryWrites=true&w=majority
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info
