# Bu dosyayi .env adi ile kopyalayin ve ornek degerleri kendi bilgilerinizle degistirin.
# Gercek sifreleri ve gizli anahtarlari Git deposuna eklemeyin.

# MongoDB Atlas baglanti adresinizi yazin (USERNAME, PASSWORD ve YOUR_CLUSTER alanlarini degistirin).
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/movieApp?retryWrites=true&w=majority
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100
LOG_LEVEL=info

# Yerel gelistirme ortami. Canli sunucuda production kullanin.
NODE_ENV=development

# Oturum imzalamak icin guclu ve benzersiz gizli anahtar olusturun.
SESSION_SECRET=replace-with-a-unique-long-random-secret

# JWT icin SESSION_SECRET'ten farkli, guclu bir gizli anahtar olusturun.
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
